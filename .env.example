# Discord Bot Token - lấy tại Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# PostgreSQL Database URL - Railway cung cấp tự động
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Prefix lệnh (mặc định là dấu chấm)
PREFIX=.

# Discord User ID của chủ bot — lấy bằng cách bật Developer Mode rồi chuột phải vào tên mình
OWNER_ID=your_discord_user_id_here
